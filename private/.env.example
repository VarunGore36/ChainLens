# Copy to .env and fill in. .env is gitignored; this file is committed.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Ethereum JSON-RPC endpoint. Contains an API key on every hosted provider, so
# it is treated as a secret: only scheme and host ever reach a log line.
CHAINLENS_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# PostgreSQL connection string. Matches the credentials in docker-compose.yml.
#
# Deliberately *not* prefixed with CHAINLENS_: sqlx's own tooling (`sqlx
# migrate`, and the compile-time-checked `query!` macros from Phase 4 onward)
# reads DATABASE_URL by name. Two names for one value is a worse problem than
# one unprefixed name.
DATABASE_URL=postgres://chainlens:chainlens@localhost:5432/chainlens

# ---------------------------------------------------------------------------
# Optional — defaults shown
# ---------------------------------------------------------------------------

# Log filter, standard tracing-subscriber syntax. Overrides the built-in default
# of "info,chainlens=debug".
RUST_LOG=info,chainlens=debug

# "text" for local development, "json" for anything that ships logs somewhere.
CHAINLENS_LOG_FORMAT=text

# Connection pool size. The committer is a single writer and needs exactly one;
# the remainder are for the query API and for ad-hoc inspection.
CHAINLENS_DB_MAX_CONNECTIONS=5

# Startup fails rather than hangs if PostgreSQL does not answer within this many
# seconds.
CHAINLENS_DB_CONNECT_TIMEOUT_SECS=5

# Maximum RPC requests per second. Hosted providers meter compute units, not
# raw requests, so this is a conservative baseline.
CHAINLENS_RPC_RATE_LIMIT=10

# Seconds to wait for an RPC response before timing out.
CHAINLENS_RPC_TIMEOUT_SECS=30

# Maximum retries for transient failures (429, 5xx, timeout). Deterministic
# errors (malformed request, method not found) are never retried.
CHAINLENS_RPC_MAX_RETRIES=3

# Block number to start backfilling from. 0 means start from the cursor
# (or genesis if no cursor exists). Set to a recent block for development.
CHAINLENS_BACKFILL_FROM=0

# How often to poll the chain head for new blocks (seconds).
CHAINLENS_HEAD_POLL_SECS=4
